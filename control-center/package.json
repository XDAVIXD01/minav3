{
  "name": "minav3-control-center",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "author": "XDAVIXD",
  "description": "Control de MINA V3 · voz IA",
  "scripts": {
    "start": "electron .",
    "dist": "node build-icon.mjs && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.xdavixd.minav3.controlcenter",
    "productName": "Control de MINA V3",
    "asar": true,
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "bot-config.json", "assets/**/*"],
    "directories": { "output": "release", "buildResources": "build" },
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Control de MINA V3",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Instalador-MINA-V3-${version}.${ext}"
    },
    "portable": { "artifactName": "Control-MINA-V3-Portable-${version}.${ext}" }
  }
}
